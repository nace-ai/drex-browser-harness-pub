{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nace.ai/internal/browser-worker/v1/spec",
  "title": "Drex browser worker protocol v1: normalized run spec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "start_url": {
      "type": "string",
      "maxLength": 2048
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "answer_schema": {
      "type": ["object", "null"]
    },
    "risky_actions": {
      "const": "deny"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["max_cost_usd", "max_seconds", "max_llm_calls"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "boolean"
        },
        "har": {
          "type": "boolean"
        }
      },
      "required": ["screenshots", "har"]
    }
  },
  "required": [
    "task",
    "start_url",
    "allowed_origins",
    "answer_schema",
    "risky_actions",
    "limits",
    "artifacts"
  ]
}
