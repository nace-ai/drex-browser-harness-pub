{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nace.ai/internal/browser-worker/v2/spec",
  "title": "Drex browser worker protocol v2: normalized run spec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "start_url": {
      "type": "string",
      "maxLength": 2048
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "answer_schema": {
      "type": ["object", "null"]
    },
    "risky_actions": {
      "const": "deny"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "max_llm_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["max_cost_usd", "max_seconds", "max_llm_calls"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "boolean"
        },
        "har": {
          "type": "boolean"
        }
      },
      "required": ["screenshots", "har"]
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_nusd": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$"
        },
        "started_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "prices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "drex_input": {
              "type": "string",
              "pattern": "^[0-9]{1,15}$"
            },
            "llm_input": {
              "type": "string",
              "pattern": "^[0-9]{1,15}$"
            },
            "llm_output": {
              "type": "string",
              "pattern": "^[0-9]{1,15}$"
            },
            "browser_second": {
              "type": "string",
              "pattern": "^[0-9]{1,15}$"
            }
          },
          "required": [
            "drex_input",
            "llm_input",
            "llm_output",
            "browser_second"
          ]
        }
      },
      "required": ["budget_nusd", "started_at_ms", "expires_at_ms", "prices"]
    }
  },
  "required": [
    "task",
    "start_url",
    "allowed_origins",
    "answer_schema",
    "risky_actions",
    "limits",
    "artifacts",
    "funding"
  ]
}
